# Server Configuration
PORT=5000
NODE_ENV=development

# Proxy Configuration
# Number of trusted reverse-proxy hops.
# Direct deployment: 0
# One trusted Nginx proxy: 1
# Two trusted proxies: 2
# Explicit IP/subnet notation: "loopback, 123.45.67.89" (advanced)
# SECURITY: TRUST_PROXY=true is NOT allowed for IP-based rate limiting safety
TRUST_PROXY=0

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/kitchen-store

# Security Configuration
# IMPORTANT: In production, use a cryptographically secure random secret (minimum 32 characters)
# This placeholder will be rejected in production. Generate with: openssl rand -base64 32
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=auth_token

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
