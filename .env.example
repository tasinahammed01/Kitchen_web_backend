# Server Configuration
PORT=5000
NODE_ENV=development

# Proxy Configuration
# TRUST_PROXY=0: No proxy (direct deployment) - DEFAULT (safe)
# TRUST_PROXY=1: Single trusted reverse proxy (e.g., Nginx behind load balancer)
# TRUST_PROXY=true: Trust all proxies (NOT recommended for production)
TRUST_PROXY=0

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/kitchen-store

# Security Configuration
# IMPORTANT: In production, use a cryptographically secure random secret (minimum 32 characters)
# This placeholder will be rejected in production. Generate with: openssl rand -base64 32
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=auth_token

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
